# Plantilla SIN valores reales. Copia este archivo como .env y llénalo tú.
# En Vercel, estas variables se capturan en Project Settings > Environment Variables.

# Cadena de conexión de MongoDB Atlas (base la_nutria)
MONGO_URI=

# Clave de cifrado de datos clínicos (genera una con: npm run generar-clave)
# Debe ser LA MISMA en local y en Vercel o no se podrán leer los datos ya cifrados.
CLAVE_CIFRADO=

# Orígenes permitidos del frontend, separados por coma
# Ejemplo en Vercel: https://tu-frontend.vercel.app
CORS_ORIGENES=

# Opcionales
PORT=5000
SESION_HORAS=12
SESION_INACTIVIDAD_MIN=30
ZONA_HORARIA=America/Mexico_City

# Solo para pruebas con base de datos (nunca la de producción)
MONGO_URI_TEST=
